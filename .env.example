# Required: Telegram bot token issued by BotFather.
# TODO: Replace this placeholder only in a local .env file or the server's protected environment file.
TELEGRAM_BOT_TOKEN=TODO_REPLACE_WITH_TELEGRAM_BOT_TOKEN

# Required: Gemini API key issued through the approved Google service.
# TODO: Replace this placeholder only in a local .env file or the server's protected environment file.
GEMINI_API_KEY=TODO_REPLACE_WITH_GEMINI_API_KEY

# Model selection is managed automatically by the application.
# Free tier models are used in priority order with automatic fallback on rate limits.
# Available models: gemini-3.5-flash-lite, gemini-3.6-flash, gemini-3.5-flash, gemini-3.1-flash-lite

# Optional: Hard timeout for one Gemini analysis request, in seconds.
GEMINI_TIMEOUT_SECONDS=30

# Required: Comma-separated Telegram numeric user IDs allowed to manage runtime rules.
# TODO: Replace with authorised administrator user IDs. Do not use usernames here.
TELEGRAM_ADMIN_USER_IDS=TODO_REPLACE_WITH_COMMA_SEPARATED_TELEGRAM_USER_IDS

# Optional: maximum Telegram updates processed concurrently while Gemini calls are in flight.
# Phase 6 cutover may lower this to 1 until keyed concurrency is verified.
TELEGRAM_CONCURRENT_UPDATES=4

# Optional: defence-in-depth allowlist of Telegram user IDs permitted to use the bot.
# Empty or unset means no extra user allowlist (admins still use TELEGRAM_ADMIN_USER_IDS).
# TODO: Set comma-separated numeric IDs when restricting the bot to approved operators.
# TELEGRAM_ALLOWED_USER_IDS=

# Runtime rules state. For production, use a service-writable path outside the repository.
JIRA_RULES_PATH=./var/jira_rules.txt

# Production workflow SQLite database (WAL). Must be an absolute path on local disk,
# outside the Git checkout and outside cloud-synced folders (OneDrive/Dropbox/iCloud).
# TODO: Replace with a server-local absolute path such as /var/lib/dztgbot/workflow.sqlite3
WORKFLOW_DB_PATH=TODO_REPLACE_WITH_ABSOLUTE_LOCAL_WORKFLOW_DB_PATH

# Required: Base HTTPS URL of the Jira Server / Data Center instance (behind VPN).
# Must not include credentials, fragments, or query strings.
# TODO: Replace with the actual Jira server URL, e.g. https://jira.internal.example.com
JIRA_URL=TODO_REPLACE_WITH_JIRA_SERVER_URL

# Optional: TLS certificate verification for Jira HTTPS (default true).
# Prefer a root-managed custom CA bundle over disabling verification.
JIRA_VERIFY_SSL=true

# Optional: absolute path to a root-managed custom CA bundle for Jira TLS.
# Requires JIRA_VERIFY_SSL=true. Do not combine with verify-disable.
# TODO: Set only when the server uses a private CA.
# JIRA_CA_BUNDLE_PATH=

# Optional: Default Jira project key (2–20 chars, A–Z then A–Z0–9).
# Gemini uses this when the runtime rules do not specify a project.
# JIRA_DEFAULT_PROJECT_KEY=

# Optional: Path for storing per-user Jira credentials (PATs).
# Defaults to the same directory as JIRA_RULES_PATH (e.g. /var/lib/dztgbot/user_credentials.json).
# USER_CREDENTIALS_PATH=

# Auth conversation lifetime for PAT collection, in seconds (default 180 = 3 minutes).
AUTH_TTL_SECONDS=180

# First-release security defaults (cannot be disabled).
AUTH_PAT_ONLY=true
PRIVATE_CHAT_ONLY=true

# Resource bounds: message batch, prompt, attachments, queues, and provider concurrency.
MAX_BATCH_MESSAGES=20
MAX_MESSAGE_CHARACTERS=8000
MAX_PROMPT_CHARACTERS=32000
MAX_ATTACHMENT_BYTES=10485760
MAX_ATTACHMENT_COUNT=10
MAX_QUEUE_SIZE=100
MAX_CONCURRENT_GEMINI=2
MAX_CONCURRENT_JIRA=4

# NetworkManager L2TP/IPsec control. Keep disabled until the private server-side profile is installed.
VPN_ENABLED=false

# Required when VPN_ENABLED=true: the local NetworkManager connection name.
# TODO: Use the id from the private .nmconnection file installed on the Linux server.
VPN_CONNECTION_NAME=TODO_REPLACE_WITH_NETWORKMANAGER_CONNECTION_NAME

# Required when VPN_ENABLED=true: absolute path to the private NetworkManager profile.
# TODO: Place the real .nmconnection file outside the repository with mode 0600.
VPN_PROFILE_PATH=TODO_REPLACE_WITH_ABSOLUTE_PRIVATE_NETWORKMANAGER_PROFILE_PATH

# TODO: Enable only after testing the full tunnel from the server console and installing
# narrowly scoped sudoers rules for the exact profile path and connection name.
VPN_ALLOW_START=false

# VPN helper executable paths on the supported target Linux server.
VPN_NMCLI_BIN=/usr/bin/nmcli
VPN_SUDO_BIN=/usr/bin/sudo

# Optional: timeout for each VPN status/start command, in seconds.
VPN_COMMAND_TIMEOUT_SECONDS=10

# Optional: Python logging level (DEBUG, INFO, WARNING, ERROR, or CRITICAL).
LOG_LEVEL=INFO
